{
  "required_python": "3.10",
  "preferred_python": "3.12",
  "packages": {
    "common": [
      {
        "module": "playwright",
        "pip": "playwright>=1.40"
      },
      {
        "module": "requests",
        "pip": "requests>=2.31"
      }
    ],
    "windows": [],
    "darwin": [],
    "linux": []
  },
  "playwright": {
    "browsers": [
      "chromium"
    ]
  },
  "runtime_record": {
    "filename": ".banxuebang_runtime.json"
  },
  "launchers": {
    "windows": {
      "gui": "start_gui.ps1",
      "cli": "start_cli.ps1"
    },
    "macos": {
      "gui": "start_gui.command",
      "cli": "start_cli.command"
    }
  }
}
