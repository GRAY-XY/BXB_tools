<Window
    x:Class="BxbHomework.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="BXB Homework">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,136,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="28" Height="28" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="BXB" Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="BXB Homework" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock
                x:Name="BackendStateText"
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="后端未连接" />
        </Grid>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="主页" Tag="home">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="助手" Tag="agent">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Message" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="作业" Tag="homework">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="工作区" Tag="workspace">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="私信" Tag="messages">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="草稿" Tag="drafts">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="28,24,28,28" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="PageHeaderPanel" Spacing="4">
                    <TextBlock x:Name="PageTitleText" Text="主页" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitleText" Visibility="Collapsed" />
                </StackPanel>

                <Border x:Name="ToolbarCard" Grid.Row="1" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="PrimaryComboBox" Width="260" SelectionChanged="OnPrimaryComboChanged" Visibility="Collapsed" />
                            <ComboBox x:Name="FilterComboBox" Width="180" SelectionChanged="OnFilterComboChanged" Visibility="Collapsed" />
                            <Button x:Name="PrimaryActionButton" Content="刷新" Click="OnPrimaryActionClick" />
                            <Button x:Name="SecondaryActionButton" Content="操作" Click="OnSecondaryActionClick" Visibility="Collapsed" />
                            <Button x:Name="ThirdActionButton" Content="操作" Click="OnThirdActionClick" Visibility="Collapsed" />
                            <Button x:Name="FourthActionButton" Content="操作" Click="OnFourthActionClick" Visibility="Collapsed" />
                            <Button x:Name="DangerActionButton" Content="删除" Click="OnDangerActionClick" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBox
                            x:Name="CommandInputBox"
                            AcceptsReturn="True"
                            MinHeight="76"
                            PlaceholderText="输入内容"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Grid x:Name="HomePanel" Grid.Row="2" ColumnSpacing="14" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="14">
                                <TextBlock Text="账号登录" FontSize="18" FontWeight="SemiBold" />
                                <TextBox
                                    x:Name="HomeAccountBox"
                                    Header="账号"
                                    PlaceholderText="输入办学帮账号"
                                    MaxLength="128" />
                                <PasswordBox
                                    x:Name="HomePasswordBox"
                                    Header="密码"
                                    PlaceholderText="输入办学帮密码"
                                    PasswordRevealMode="Peek"
                                    MaxLength="256" />
                                <CheckBox
                                    x:Name="HomeRememberCredentialCheckBox"
                                    Content="使用 Windows 凭据保险库保存账号和密码" />
                                <CheckBox
                                    x:Name="HomeAgreeTermsCheckBox"
                                    Content="我同意办学帮登录页的用户协议和隐私政策" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="HomeLoginButton"
                                        Content="登录"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="OnHomeCredentialLoginClick" />
                                    <Button
                                        x:Name="HomeClearCredentialButton"
                                        Content="清除已保存凭据"
                                        Click="OnHomeClearCredentialClick" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="HomeLoginStatusText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="账号密码不会写入项目配置或应用日志。" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Spacing="8">
                                    <TextBlock Text="当前学期" FontWeight="SemiBold" />
                                    <ComboBox x:Name="HomeTermComboBox" MinWidth="280" PlaceholderText="读取学期中" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="切换学期" Click="OnHomeTermApplyClick" />
                                        <Button Content="刷新学期" Click="OnHomeTermRefreshClick" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="HomeRuntimeText" Text="BXB Homework" FontWeight="SemiBold" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="1" Padding="18" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="当前会话" FontSize="18" FontWeight="SemiBold" />
                            <Grid Grid.Row="1" ColumnSpacing="18" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Spacing="3">
                                    <TextBlock Text="登录状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="HomeSessionStatusText" Text="读取中" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="待处理作业" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="HomePendingTaskText" Text="-" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Spacing="3">
                                    <TextBlock Text="用户" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="HomeUserText" Text="-" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                    <TextBlock Text="班级 / 课程" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="HomeScopeText" Text="-" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Spacing="3">
                                    <TextBlock Text="学期" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="HomeTermText" Text="-" TextWrapping="WrapWholeWords" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                                    <TextBlock Text="凭据保存" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="HomeCredentialStatusText" Text="未保存" TextWrapping="WrapWholeWords" MaxLines="3" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="AgentPanel" Grid.Row="0" Grid.RowSpan="3" MinHeight="480" Visibility="Collapsed" SizeChanged="OnAgentPanelSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="AgentConversationColumn" Width="260" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="AgentConversationPane"
                        BorderThickness="0,0,1,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid Padding="12,14,12,12" RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button Click="OnAgentNewConversationClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="新建对话" />
                                </StackPanel>
                            </Button>
                            <TextBox
                                x:Name="AgentConversationSearchBox"
                                Grid.Row="1"
                                PlaceholderText="搜索对话"
                                TextChanged="OnAgentConversationSearchTextChanged" />
                            <ListView
                                x:Name="AgentConversationListView"
                                Grid.Row="2"
                                SelectionMode="Single"
                                SelectionChanged="OnAgentConversationSelectionChanged"
                                HorizontalContentAlignment="Stretch">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:DisplayItem" xmlns:local="using:BxbHomework.WinUI">
                                        <Grid Padding="8,6" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="对话操作">
                                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="重命名" Tag="{x:Bind Id}" Click="OnAgentRenameConversationClick">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="删除" Tag="{x:Bind Id}" Click="OnAgentDeleteConversationClick">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <Grid Padding="14,0" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="AgentConversationPaneToggleButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    Click="OnAgentConversationPaneToggleClick"
                                    ToolTipService.ToolTip="显示或隐藏对话列表">
                                    <FontIcon Glyph="&#xE700;" FontSize="16" />
                                </Button>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock x:Name="AgentConversationTitleText" Text="新对话" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AgentModelText" Text="正在读取模型配置" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Width="150" VerticalAlignment="Center" Spacing="3" ToolTipService.ToolTip="当前对话的估算上下文占用">
                                    <TextBlock x:Name="AgentContextUsageText" Text="上下文：计算中" FontSize="12" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar x:Name="AgentContextProgressBar" Minimum="0" Maximum="100" Value="0" Height="3" />
                                    <TextBlock x:Name="AgentContextStatusText" Text="" Visibility="Collapsed" />
                                </StackPanel>
                                <Button Grid.Column="3" Width="36" Height="36" Padding="0" ToolTipService.ToolTip="对话操作">
                                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="重命名对话" Click="OnAgentRenameConversationClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="压缩上下文" Click="OnAgentCompactClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="删除对话" Click="OnAgentDeleteConversationClick">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>

                        <Grid x:Name="AgentMarkdownHost" Grid.Row="1" MaxWidth="900" HorizontalAlignment="Stretch">
                            <TextBox
                                x:Name="AgentMarkdownFallbackTextBox"
                                Margin="24,12"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                BorderThickness="0"
                                Background="Transparent"
                                ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>

                        <Grid Grid.Row="2" MaxWidth="900" Padding="24,10,24,16" HorizontalAlignment="Stretch">
                            <Border
                                Padding="12,8,8,8"
                                CornerRadius="8"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <Grid RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBox
                                        x:Name="AgentInputBox"
                                        AcceptsReturn="False"
                                        MinHeight="44"
                                        MaxHeight="132"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        PlaceholderText="给 BXB 助手发送消息"
                                        TextWrapping="Wrap"
                                        PreviewKeyDown="OnAgentInputKeyDown" />
                                    <Grid Grid.Row="1">
                                        <TextBlock Text="Enter 发送 · Ctrl+Enter 换行" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <Button
                                            x:Name="AgentSendButton"
                                            Width="36"
                                            Height="36"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            Click="OnAgentSendClick"
                                            ToolTipService.ToolTip="发送">
                                            <FontIcon x:Name="AgentSendIcon" Glyph="&#xE724;" FontSize="16" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border
                        x:Name="AgentStepsDrawer"
                        Grid.Column="1"
                        Width="370"
                        Padding="16"
                        HorizontalAlignment="Right"
                        BorderThickness="1,0,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        Visibility="Collapsed"
                        Canvas.ZIndex="20">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="工作过程" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Width="36" Height="36" Padding="0" HorizontalAlignment="Right" Click="OnAgentStepsDrawerCloseClick" ToolTipService.ToolTip="关闭工作过程">
                                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1">
                                <TextBox
                                    x:Name="AgentStepsTextBox"
                                    Visibility="Collapsed"
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap" />
                                <ScrollViewer x:Name="AgentStepsScrollViewer" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="AgentStepsStackPanel" Spacing="10" />
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="SplitPanel" Grid.Row="2" ColumnSpacing="14" MinHeight="480" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SplitLeftColumn" Width="360" MinWidth="260" />
                        <ColumnDefinition Width="*" MinWidth="420" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="0" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ListTitleText" Text="列表" Margin="14,14,14,8" FontSize="18" FontWeight="SemiBold" />
                            <ListView x:Name="MainListView" Grid.Row="1" Margin="8,0,8,8" SelectionChanged="OnMainListSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:DisplayItem" xmlns:local="using:BxbHomework.WinUI">
                                        <StackPanel Spacing="3" Padding="4">
                                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" MaxLines="2" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="DetailTitleText" Text="详情" FontSize="18" FontWeight="SemiBold" />
                            <TextBox
                                x:Name="DetailTextBox"
                                Grid.Row="1"
                                AcceptsReturn="True"
                                IsReadOnly="True"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="EditorTextBox"
                                Grid.Row="1"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <ScrollViewer
                                x:Name="HomeworkDetailScrollViewer"
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="Collapsed">
                                <StackPanel x:Name="HomeworkDetailStackPanel" Spacing="12" />
                            </ScrollViewer>
                            <ListView
                                x:Name="PrivateThreadListView"
                                Grid.Row="1"
                                IsItemClickEnabled="False"
                                SelectionMode="None"
                                Visibility="Collapsed">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:PrivateThreadMessage" xmlns:local="using:BxbHomework.WinUI">
                                        <Grid Padding="6,4">
                                            <Border
                                                MaxWidth="560"
                                                Padding="11,9"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                HorizontalAlignment="{x:Bind Alignment}">
                                                <StackPanel Spacing="5">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{x:Bind Sender}" FontSize="12" FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind Time}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Content}" TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <ScrollViewer
                                x:Name="DetailImageScrollViewer"
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="Collapsed">
                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                    <Image
                                        x:Name="WorkspaceImagePreview"
                                        MaxWidth="860"
                                        MaxHeight="560"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Center" />
                                    <TextBlock
                                        x:Name="DetailImageCaption"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                            <WebView2
                                x:Name="DetailDocumentWebView"
                                Grid.Row="1"
                                Visibility="Collapsed" />
                            <StackPanel x:Name="PrivateMessageComposerPanel" Grid.Row="2" Spacing="8" Visibility="Collapsed">
                                <TextBox
                                    x:Name="PrivateMessageInputBox"
                                    AcceptsReturn="True"
                                    MinHeight="72"
                                    PlaceholderText="输入要发送给当前联系人的文本私信"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                    <Button Content="发送" Click="OnPrivateMessageSendClick" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="DetailActionPanel" Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DetailPrimaryButton" Content="确认" Click="OnDetailPrimaryClick" Visibility="Collapsed" />
                                <Button x:Name="DetailSecondaryButton" Content="取消" Click="OnDetailSecondaryClick" Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed">
                    <Grid ColumnSpacing="14" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.08*" MinWidth="420" />
                            <ColumnDefinition Width="0.92*" MinWidth="360" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="SettingsMainTextBox" Visibility="Collapsed" />

                        <Border Grid.ColumnSpan="2" Padding="0" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid RowSpacing="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TabView
                                    x:Name="SettingsModelRoleTabView"
                                    Height="46"
                                    Padding="8,6,8,0"
                                    Background="{ThemeResource LayerFillColorAltBrush}"
                                    CornerRadius="7,7,0,0"
                                    CanDragTabs="False"
                                    IsAddTabButtonVisible="False"
                                    TabWidthMode="SizeToContent"
                                    SelectionChanged="OnSettingsModelRoleTabSelectionChanged">
                                    <TabView.Resources>
                                        <StaticResource x:Key="TabViewItemHeaderBackgroundSelected" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                                    </TabView.Resources>
                                    <TabViewItem Header="对话" IsClosable="False" Tag="chat" MinWidth="190" MaxWidth="240">
                                        <TabViewItem.IconSource>
                                            <SymbolIconSource Symbol="Message" />
                                        </TabViewItem.IconSource>
                                    </TabViewItem>
                                    <TabViewItem Header="图片转述" IsClosable="False" Tag="image_caption" MinWidth="190" MaxWidth="240">
                                        <TabViewItem.IconSource>
                                            <SymbolIconSource Symbol="Pictures" />
                                        </TabViewItem.IconSource>
                                    </TabViewItem>
                                </TabView>
                                <CheckBox
                                    x:Name="SettingsImageCaptionEnabledCheckBox"
                                    Grid.Row="1"
                                    Margin="14,12,14,0"
                                    Content="启用图片转述"
                                    Visibility="Collapsed"
                                    Checked="OnSettingsImageCaptionEnabledChanged"
                                    Unchecked="OnSettingsImageCaptionEnabledChanged" />
                            <Grid Grid.Row="2" Margin="14,12,14,14" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="提供商源" FontSize="18" FontWeight="SemiBold" />
                                        <Button x:Name="SettingsAddProviderButton" Grid.Column="1" Content="+ 新增" Click="OnSettingsAddProviderClick" />
                                    </Grid>
                                    <ListView x:Name="SettingsProviderListView" MinHeight="260" SelectionChanged="OnSettingsProviderSelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="local:DisplayItem" xmlns:local="using:BxbHomework.WinUI">
                                                <Grid Padding="8,6" RowSpacing="3">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1" Text="{x:Bind Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="2" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock
                                        x:Name="SettingsProviderEmptyText"
                                        Text="当前标签还没有模型提供商，请点击“新增”。"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="WrapWholeWords"
                                        Visibility="Collapsed" />
                                    <Border x:Name="SettingsProviderCreatePanel" Visibility="Collapsed" Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="新增模型提供商" FontWeight="SemiBold" />
                                            <ComboBox x:Name="SettingsProviderTypeComboBox" Header="提供商类型" SelectionChanged="OnSettingsProviderTypeSelectionChanged" />
                                            <TextBox x:Name="SettingsNewProviderNameBox" Header="名称" PlaceholderText="例如 Moonshot、DeepSeek、学校代理" />
                                            <TextBox x:Name="SettingsNewProviderBaseUrlBox" Header="Base URL" PlaceholderText="https://api.example.com/v1" />
                                            <PasswordBox x:Name="SettingsNewProviderApiKeyBox" Header="API Key" PlaceholderText="请输入该提供商的 API Key" />
                                            <TextBox x:Name="SettingsNewProviderModelNameBox" Header="默认模型" PlaceholderText="可以稍后读取模型列表再选择" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="保存提供商" Click="OnSettingsSaveNewProviderClick" />
                                                <Button Content="取消" Click="OnSettingsCancelNewProviderClick" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="SettingsProviderDetailsPanel" Grid.Column="1" Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="SettingsProviderTitleText" Text="模型配置" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SettingsProviderEndpointText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                    <TextBlock Text="设置" FontWeight="SemiBold" />
                                    <TextBox x:Name="SettingsProviderNameBox" Header="名称" PlaceholderText="例如 Moonshot、OpenAI、DeepSeek" />
                                    <PasswordBox x:Name="SettingsApiKeyBox" Header="API Key" PlaceholderText="留空则保留已保存的 Key" />
                                    <TextBox x:Name="SettingsBaseUrlBox" Header="API Base URL" PlaceholderText="https://api.example.com/v1" />
                                    <TextBlock Text="模型名称" FontWeight="SemiBold" />
                                    <TextBox x:Name="SettingsModelNameBox" PlaceholderText="手动输入，或先读取模型列表后选择" />
                                    <ComboBox x:Name="SettingsModelComboBox" Visibility="Collapsed" SelectionChanged="OnSettingsModelSelectionChanged" />
                                    <TextBox x:Name="SettingsContextLengthBox" Header="上下文长度" InputScope="Number" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SettingsChatTemperatureBox" Header="助手对话 Temperature" InputScope="Number" />
                                        <TextBox x:Name="SettingsCompactTemperatureBox" Grid.Column="1" Header="压缩上下文 Temperature" InputScope="Number" />
                                    </Grid>
                                    <TextBlock x:Name="SettingsModelStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="保存配置" Click="OnSettingsSaveConfigClick" />
                                        <Button Content="测试连通性" Click="OnSettingsTestConfigClick" />
                                        <Button Content="读取模型" Click="OnSettingsLoadModelsClick" />
                                        <Button x:Name="SettingsDeleteProviderButton" Content="删除提供商" Click="OnSettingsDeleteProviderClick" />
                                        <Button Content="清除配置" Click="OnSettingsClearConfigClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="软件更新" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Windows 正式版" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SettingsVersionBadgeText" Grid.Column="1" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="当前版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SettingsCurrentVersionText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="最新版本" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SettingsLatestVersionText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SettingsUpdateStatusText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="SettingsUpdateNotesText" TextWrapping="WrapWholeWords" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="检查更新" Click="OnSettingsCheckUpdatesClick" />
                                    <Button Content="打开 Release 页面" Click="OnSettingsOpenReleaseClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="界面与 Agent" FontSize="18" FontWeight="SemiBold" />
                                <ComboBox x:Name="SettingsThemeComboBox" Header="主题" SelectionChanged="OnSettingsThemeSelectionChanged">
                                    <ComboBoxItem Content="浅色" Tag="light" />
                                    <ComboBoxItem Content="深色" Tag="dark" />
                                </ComboBox>
                                <TextBox x:Name="SettingsMaxToolRoundsBox" Header="最大工具轮次" InputScope="Number" />
                                <TextBox x:Name="SettingsLongPasteThresholdBox" Header="长文本粘贴阈值" InputScope="Number" />
                                <TextBlock Text="粘贴文本达到该字数时，将保存为工作区 TXT 文件，而不是直接放入输入框。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBox x:Name="SettingsSystemPromptBox" Header="AI 系统提示词" MinHeight="132" AcceptsReturn="True" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="保存设置" Click="OnSettingsSaveConfigClick" />
                                    <Button Content="恢复默认提示词" Click="OnSettingsRestoreDefaultPromptClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="路径" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="只展示默认目录的用途，不显示完整应用诊断 JSON。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <ListView x:Name="SettingsPathListView" Grid.Row="2" IsItemClickEnabled="False" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:DisplayItem" xmlns:local="using:BxbHomework.WinUI">
                                            <Grid Padding="4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                                    <TextBlock Text="{x:Bind Path}" FontFamily="Consolas" FontSize="12" TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="打开路径" Tag="{x:Bind Id}" Click="OnSettingsPathItemOpenClick" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button x:Name="SettingsOpenPathButton" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="StatusText" Margin="18,0" VerticalAlignment="Center" Text="Ready" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Border>
    </Grid>
</Window>
